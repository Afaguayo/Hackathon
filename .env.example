# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel: Project → Settings → Environment Variables (same names).

# ElevenLabs → Developers → API Keys. Needs Text to Speech + ElevenLabs Agents permissions.
ELEVENLABS_API_KEY=

# Voice used for "Read aloud". ElevenLabs → Voices → pick a voice → copy its Voice ID.
ELEVENLABS_VOICE_ID=

# The reading-companion agent. ElevenLabs → Agents → your agent → copy its Agent ID.
# Set the agent to private (authentication on) so only our signed URLs can start sessions.
# It is also the template copied for each uploaded document's own agent.
ELEVENLABS_AGENT_ID=

# Post-call webhook secret. ElevenLabs → Agents → Settings → Post-call webhook shows it when you add
# <deploy-url>/api/webhooks/elevenlabs. Transcripts are only saved when this is set.
ELEVENLABS_WEBHOOK_SECRET=

# Shared secret for agent server tools (e.g. save_note). Make one up: `openssl rand -hex 32`,
# and send it as the `x-agent-tool-secret` header in the tool config on ElevenLabs.
ELEVENLABS_TOOL_SECRET=

# Neon Postgres. Vercel → Storage → Neon adds these automatically when deployed.
# Locally, `npx neon@latest claim create --file .env` makes a temporary database.
DATABASE_URL=
# Direct (unpooled) connection, used by `npm run db:migrate`. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
